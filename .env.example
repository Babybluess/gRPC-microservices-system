# Copy to .env and adjust. Source before running: source .env
# All values below are the built-in defaults — only set what you need to override.

# Consul agent address
CONSUL_ADDR=localhost:8500

# OpenTelemetry collector (OTLP/gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# TLS — server-side (user-service, order-service)
TLS_CERT_FILE=certs/server.pem
TLS_KEY_FILE=certs/server-key.pem

# TLS — client-side (gateway, http-gateway)
TLS_CA_FILE=certs/ca.pem

# Bearer token required on every authenticated RPC.
# Can also be stored in Consul KV: consul kv put grpcshop/auth-token "Bearer my-token"
AUTH_TOKEN=Bearer secret-token

# gRPC listen port (set per-service; user defaults to 50051, order to 50052)
# PORT=50051

# HTTP listen address for http-gateway
HTTP_PORT=:8080

# Hostname advertised to Consul for health checks (change when running in Docker/K8s)
SERVICE_HOST=localhost
